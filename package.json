{
  "name": "newstatus-hd",
  "version": "5.0.5",
  "private": true,
  "description": "ALL VD HD (HD Jir) v5 — upload & kirim video HD anti pecah ke WhatsApp Status, TikTok, IG Reels/Story & YT Shorts (ALL VD HD Engine v5) by [Rifky]",
  "license": "MIT",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --workspace client",
    "dev": "concurrently -n server,client -c violet,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspace client",
    "start": "node server/index.js",
    "smoke": "node scripts/smoke.js",
    "bench": "node scripts/engine-bench.js",
    "bench:hq": "node scripts/engine-bench.js --hq",
    "icons": "node tools/make-icons.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.1",
    "pino": "^9.5.0",
    "socket.io": "^4.8.1"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "sharp": "^0.35.4"
  }
}
